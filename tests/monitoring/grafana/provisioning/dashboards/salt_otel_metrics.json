{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs published (total)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(salt_jobs_published_total)", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs completed (total returns)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(salt_jobs_completed_total)", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests handled (total)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(salt_master_requests_handled_total)", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Auth attempts (total)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(salt_auth_attempts_total)", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Jobs published / completed (cumulative)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(salt_jobs_published_total)", "legendFormat": "published", "refId": "A"},
        {"expr": "sum by (success) (salt_jobs_completed_total)", "legendFormat": "completed success={{success}}", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Jobs published / completed per second",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum(rate(salt_jobs_published_total[1m]))", "legendFormat": "published", "refId": "A"},
        {"expr": "sum(rate(salt_jobs_completed_total[1m]))", "legendFormat": "completed", "refId": "B"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests handled per second, by cmd",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (cmd) (rate(salt_master_requests_handled_total[1m]))", "legendFormat": "{{cmd}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request duration p50 / p95 / p99 (ms)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(salt_master_requests_duration_milliseconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(salt_master_requests_duration_milliseconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(salt_master_requests_duration_milliseconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Auth attempts by result (cumulative)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum by (result) (salt_auth_attempts_total)", "legendFormat": "{{result}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "tags": ["salt", "otel"],
  "time": {"from": "now-30m", "to": "now"},
  "title": "Salt OTel Metrics",
  "uid": "salt-otel",
  "version": 1
}
